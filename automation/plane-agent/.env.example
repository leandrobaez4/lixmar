# Plane
PLANE_BASE_URL=http://localhost:8081
PLANE_API_KEY=plane_api_REEMPLAZAR
PLANE_WORKSPACE_SLUG=lixmar
PLANE_PROJECT_ID=7982a9e7-95a3-4c24-9f8e-6569129a11ad
PLANE_WEBHOOK_SECRET=reemplazar-con-el-secreto-del-webhook

# Servidor
PORT=8787
DATA_DIR=./data
MAX_ATTEMPTS=5
RETRY_BASE_MS=5000
WORKER_POLL_MS=1000
ISSUE_COOLDOWN_MS=30000
PROCESS_UPDATES=false
MAX_DAILY_LLM_CALLS=50
MAX_PROMPT_CHARS=30000
CYCLE_CAPACITY_POINTS=20

# LLM: openai-compatible | anthropic | gemini | ollama
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-5-mini
LLM_API_KEY=reemplazar
LLM_BASE_URL=https://api.openai.com
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_MS=60000
# Opcional: un segundo proveedor/modelo para errores de red, límites o fallas del primario.
# LLM_FALLBACK_PROVIDER=anthropic
# LLM_FALLBACK_MODEL=claude-sonnet-modelo-disponible
# LLM_FALLBACK_API_KEY=reemplazar
# LLM_FALLBACK_BASE_URL=https://api.anthropic.com

# Seguridad. En simulación no se escribe en Plane.
DRY_RUN=true
ACTION_MODE_UPDATE_WORK_ITEM=auto
ACTION_MODE_ADD_COMMENT=auto
ACTION_MODE_CREATE_WORK_ITEM=approval
ACTION_MODE_CREATE_SUBTASK=approval
ACTION_MODE_ADD_TO_MODULE=approval
ACTION_MODE_ADD_TO_CYCLE=approval

# Opcional: evita reaccionar a eventos generados por el propio agente.
PLANE_AGENT_ACTOR_ID=
